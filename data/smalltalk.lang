<?xml version="1.0" encoding="UTF-8"?>
<language id="smalltalk" _name="Smalltalk" version="2.0" _section="Source">

  <metadata>
    <property name="mimetypes">text/x-smalltalk</property>
    <property name="globs">*.st</property>
    <property name="line-comment-start">"</property>
  </metadata>

  <styles>
    <style id="identifier"     _name="Identifier"        map-to="def:identifier"/>
    <style id="keyword"        _name="Keyword Message"   map-to="def:keyword"/>
    <style id="reserved-word"  _name="Reserved Word"     map-to="def:builtin"/>
    <style id="string"         _name="String"            map-to="def:string"/>
    <style id="special-string" _name="Special String"    map-to="def:comment"/>
    <style id="floating-point" _name="Floating Point"    map-to="def:floating-point"/>
    <style id="decimal"        _name="Decimal"           map-to="def:decimal"/>
    <style id="escape"         _name="Escaped Character" map-to="def:special-char"/>
    <style id="quoted-selector" _name="Quoted Selector"  map-to="def:constant"/>
  </styles>

  <definitions>

    <!-- Reserved words: Smalltalk, self, super (mapped to def:builtin,
         not def:reserved, since many color schemes give def:reserved a
         background fill that's too jarring for pseudo-variables) -->
    <context id="reserved-word" style-ref="reserved-word">
      <keyword>Smalltalk</keyword>
      <keyword>self</keyword>
      <keyword>super</keyword>
    </context>

    <!-- Keywords: an identifier immediately followed by a colon, e.g. "at:" "put:" -->
    <context id="keyword" style-ref="keyword">
      <match>[a-zA-Z][a-zA-Z_0-9]*:</match>
    </context>

    <!-- Plain identifiers: [a-zA-Z][a-zA-Z_0-9]* -->
    <context id="identifier" style-ref="identifier">
      <match>[a-zA-Z][a-zA-Z_0-9]*</match>
    </context>

    <!-- Single-quoted strings: 'text' with backslash-escaping, \'([^\'\\]|\\.)*\' -->
    <context id="single-quoted-string" style-ref="string" end-at-line-end="false" class="string" class-disabled="no-spell-check">
      <start>'</start>
      <end>'</end>
      <include>
        <context id="string-escape" style-ref="escape" extend-parent="true">
          <match>\\.</match>
        </context>
      </include>
    </context>

    <!-- Double-quoted strings: "text" (no escaping), \"[^\"]*\" -->
    <context id="double-quoted-string" style-ref="special-string" end-at-line-end="false" class="string" class-disabled="no-spell-check">
      <start>"</start>
      <end>"</end>
    </context>

    <!-- Quoted selectors (symbols): #foo, #+, #at:put:
         Original pattern:
           \#([a-zA-Z][a-zA-Z_0-9]*|(!|%|&|\*|\+|,|\/|<|=|>|\?|@|\\|~|\||-)+|([a-zA-Z_][a-zA-Z_0-9]*:)+)
         The alternatives are reordered so the keyword form comes first:
         regex alternation takes the first alternative that matches, so
         with the plain-identifier form first, #at:put: would stop at #at.
         &amp; &lt; &gt; are XML escapes for & < >. -->
    <context id="quoted-selector" style-ref="quoted-selector">
      <match>#(?:(?:[a-zA-Z_][a-zA-Z_0-9]*:)+|[a-zA-Z][a-zA-Z_0-9]*|(?:!|%|&amp;|\*|\+|,|/|&lt;|=|&gt;|\?|@|\\|~|\||-)+)</match>
    </context>

    <!-- Floats: [-]?[0-9]+\.[0-9]+((e|d|q)[-]?[0-9]+)? -->
    <context id="float" style-ref="floating-point">
      <match extended="true">
        -?[0-9]+\.[0-9]+((e|d|q)-?[0-9]+)?
      </match>
    </context>

    <!-- Integers: [-]?[0-9]+ or radix form [0-9]+r[0-9A-Z]+ -->
    <context id="integer" style-ref="decimal">
      <match extended="true">
        -?[0-9]+|[0-9]+r[0-9A-Z]+
      </match>
    </context>

    <!--
      Top-level context.
      Order matters: GtkSourceView resolves ties (matches starting at the
      same position) in favor of whichever context is listed first, so:
        - float must precede integer (so "1.5" isn't split into "1" + ".5")
        - keyword must precede identifier (so "at:" isn't split into
          identifier "at" + a lone ":")
    -->
    <context id="smalltalk" class="no-spell-check">
      <include>
        <context ref="single-quoted-string"/>
        <context ref="double-quoted-string"/>
        <context ref="quoted-selector"/>
        <context ref="float"/>
        <context ref="integer"/>
        <context ref="reserved-word"/>
        <context ref="keyword"/>
        <context ref="identifier"/>
      </include>
    </context>

  </definitions>
</language>
